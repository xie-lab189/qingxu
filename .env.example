# 青序 · 环境变量示例
# 复制为 .env（本地开发用，切勿提交真实密钥到仓库）

# —— 智谱大模型 Key ——
# 服务端隐藏：部署到 Vercel 时，在 Dashboard → Settings → Environment Variables 添加 ZHIPU_API_KEY
# 本地用 Node (npm start) 时，执行：export ZHIPU_API_KEY=你的key（Windows: set ZHIPU_API_KEY=你的key）
ZHIPU_API_KEY=your-zhipu-api-key

# —— Supabase（跨设备云同步）——
# 在 Supabase 控制台 → Project Settings → API 获取
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# —— 可选：独立后端 API 地址（默认同源，留空即可）——
# VITE_API_URL=
